  if (url.pathname === "/emails/metrics") {
    assert.equal(url.searchParams.get("domain_id"), ATLAS_DOMAIN_ID);
    return response({ object: "metrics", totals: { sent: 10, delivered: 8, open_rate: 50 }, data: [], start_date: "2026-10-01", end_date: "2026-10-13" });
  }
  if (url.pathname === `/broadcasts/${campaignId}`) return response({ id: campaignId, segment_id: foreign ? "other-brand" : process.env.ATLAS_RESEND_SEGMENT_ID, from: FROM });
  if (url.pathname === "/segments") return response({ data: [{ id: crm, name: imports.CRM_NAME }, { id: blocked, name: imports.BLOCKED_NAME }], has_more: false });
  if (url.pathname === "/contacts" && method === "GET") return response({ data: [{ id: "existing-id", email: "existing@example.com", unsubscribed: true }], has_more: false });
  if (url.pathname === "/contact-properties") return response({ data: ["atlas_source_id", "atlas_source_status", "atlas_groups", "atlas_subscribed_at", "atlas_bounce"].map((key) => ({ key })), has_more: false });
  if (url.pathname === "/contacts/imports") return response({ id: job });
  if (url.pathname === `/contacts/imports/${job}`) return response({ id: job, status: "completed", counts: { total: 1, created: 1, skipped: 0, failed: 0 } });
  if (url.pathname === "/contacts/existing%40example.com" || url.pathname === "/contacts/existing@example.com") return response({ id: "existing-id", email: "existing@example.com", unsubscribed: true });
  if (url.pathname === "/contacts/existing-id/segments" && method === "GET") return response({ data: [{ id: process.env.ATLAS_RESEND_SEGMENT_ID }], has_more: false });
  return response({ id: "existing-id", data: [], has_more: false });
